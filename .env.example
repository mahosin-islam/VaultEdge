# ============================================================================
# VaultEdge — Environment Configuration Template (.env.example)
# Copy this file to `.env` for local development and fill in your own secrets.
# NEVER commit your real `.env` file or real credentials to Git.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Runtime & Application URL (Safe Development Defaults)
# ----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (Developer Must Provide Password)
# ----------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://postgres:<YOUR_LOCAL_PASSWORD>@localhost:5432/vaultedge?schema=public"

# ----------------------------------------------------------------------------
# 3. Custom JWT Authentication Secrets (Generate Locally — See docs/ENVIRONMENT_VARIABLES.md)
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET="<GENERATE_LOCAL_64_BYTE_HEX_SECRET>"
JWT_REFRESH_SECRET="<GENERATE_LOCAL_64_BYTE_HEX_SECRET>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
